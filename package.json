      "refactor": { "title": "🚜 Refactoring", "semver": "patch" },
      "perf": { "title": "⚡ Performance", "semver": "patch" },
      "test": { "title": "🧪 Tests" },
      "ci": { "title": "⚙️ CI" },
      "chore": { "title": "🔧 Sonstiges" },
      "revert": { "title": "◀️ Revert" }
    },
